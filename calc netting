SELECT DISTINCT
    COLL.SERIAL,
    TRN.ID              AS ID_TRAN,
    COLL.FGL_TRN_ID     AS ID_COLL,

    'Netting' AS COLLECTION_TYPE_DESC,

    CS.NAME     AS CUSTOMER_NAME,
    CUSTOM.NAME AS AGENT_NAME,

    COLL.TOTAL_DEBIT AS TOTAL_COLLECTION_PAID_AMOUNT,

    CASE 
        WHEN COLL.STATUS = 5 THEN 'SETTLED'
        ELSE NULL
    END AS STATUS_DESC,

    COLL.CREATED_BY,
    COLL.CREATION_DATE,
    COLL.STATUS_DATE,

    NULL AS PAYMENT_METHOD,

    POL.SEGMENT_CODE AS POLICY_SEGMENT,
    BRAN.NAME        AS BRANCH_NAME,
    NULL             AS DOC_TYPE,
    TRN.SEGMENT_CODE AS VOUCHER_NO,

    NULL AS PAID_AMOUNT_PRE_POLICY,
    NULL AS PAID_CURRENCY_PRE_POLICY,

    POL.NET_PREMIUM AS GROSS_POLICY_AMOUNT,
    POL.CRG_CUR_CODE AS ISSUE_CURRENCY,

    IGENERAL.DBF_GET_OS_PREMIUM(
        POL.ID
    ) AS POLICY_OUTSTANDING,

    LEAST(
        NVL(COLL.TOTAL_DEBIT, 0),
        NVL(
            IGENERAL.DBF_GET_OS_PREMIUM(POL.ID),
            0
        )
    ) AS NETTING_AMOUNT,

    NULL AS NOTES,
    NULL AS NOTES2,

    NULL AS DUE_AMOUNT,
    NULL AS STATUS

FROM ERP.FCM_COLLECTION COLL

LEFT JOIN ERP.FCM_COL_DETAILS DET
       ON COLL.ID = DET.FCM_COL_ID

LEFT JOIN ERP.FGL_TRANSACTIONS TRN
       ON DET.FGL_TRN_ID = TRN.ID
      AND TRN.IS_DELETED = 0

LEFT JOIN IGENERAL.GPD_VOUCHERS VSH
       ON VSH.FGL_TRN_ID = TRN.ID

LEFT JOIN IGENERAL.GPD_INSTALLMENTS INS
       ON VSH.GPD_INS_ID = INS.ID

LEFT JOIN IGENERAL.GPD_POLICIES POL
       ON INS.GPD_PLC_ID = POL.ID

LEFT JOIN ERP.FCS_CUSTOMERS CS
       ON POL.FCS_CST_ID_ACC = CS.ID

INNER JOIN ERP.FCS_CUSTOMERS CUSTOM
       ON COLL.FCS_CST_ID = CUSTOM.ID

INNER JOIN ICORE3.CRG_BRANCHES BRAN
       ON BRAN.ID = COLL.CRG_BRN_ID

WHERE COLL.COLLECTION_TYPE = 3
  AND COLL.STATUS = 5
  AND COLL.STATUS_DATE >= TO_DATE(:P_FROM_DATE,'DD-MM-RRRR')
  AND COLL.STATUS_DATE <  TO_DATE(:P_TO_DATE,'DD-MM-RRRR') + 1;
