WITH LAST_CLAIM_TRANSACTION AS (
    SELECT
        GCT.ID,
        GCT.GCL_CLM_ID,
        GCT.GCL_CLT_SERIAL,
        GCT.LOSS_TYPE,
        GCT.SERIAL,
        GCT.TRANS_DATE,
        GCT.CLAIM_TRANS_TYPE,
        GCT.IS_POSTED,
        GCT.IS_REVERSED,
        GCT.IS_REINSURED,

        ROW_NUMBER() OVER (
            PARTITION BY
                GCT.GCL_CLM_ID,
                GCT.GCL_CLT_SERIAL,
                GCT.LOSS_TYPE
            ORDER BY
                TRUNC(GCT.TRANS_DATE) DESC,
                GCT.SERIAL DESC
        ) AS RN

    FROM IGENERAL.GCL_CLAIM_TRANSACTIONS GCT
    WHERE GCT.CLAIM_TRANS_TYPE = 1
      AND TRUNC(GCT.TRANS_DATE) <= TO_DATE(:P_TO_DATE, 'DD/MM/YYYY')
)

SELECT
    POL.SEGMENT_CODE AS POLICY_NO,

    GC.ID AS CLAIM_ID,
    GC.SEGMENT_CODE AS CLAIM_NO,

    GCT.ID AS TRANSACTION_ID,
    GCT.SERIAL,
    GCT.GCL_CLT_SERIAL,
    GCT.TRANS_DATE,
    GCT.CLAIM_TRANS_TYPE,
    GCT.LOSS_TYPE,
    GCT.IS_POSTED,
    GCT.IS_REVERSED,
    GCT.IS_REINSURED,

    IGENERAL.DBF_GET_OS_AMOUNT(
        GC.ID,
        CLMT.SERIAL,
        GCT.LOSS_TYPE,
        TO_DATE(:P_AS_AT, 'DD/MM/YYYY'),
        NULL,
        0,
        0,
        0
    ) AS CLAIM_OUTSTANDING

FROM IGENERAL.GCL_CLAIMS GC

INNER JOIN LAST_CLAIM_TRANSACTION GCT
    ON GCT.GCL_CLM_ID = GC.ID
   AND GCT.RN = 1

INNER JOIN IGENERAL.GCL_CLAIMANTS CLMT
    ON CLMT.GCL_CLM_ID = GC.ID
   AND CLMT.SERIAL = GCT.GCL_CLT_SERIAL

LEFT JOIN IGENERAL.GPD_POLICIES POL
    ON POL.ID = GC.GPD_PLC_ID

WHERE GC.SEGMENT_CODE = 'C/01/ENG/CPM/01/2021/00404'

  AND IGENERAL.DBF_GET_OS_AMOUNT(
        GC.ID,
        CLMT.SERIAL,
        GCT.LOSS_TYPE,
        TO_DATE(:P_AS_AT, 'DD/MM/YYYY'),
        NULL,
        0,
        0,
        0
      ) <> 0

ORDER BY
    POL.SEGMENT_CODE,
    GC.SEGMENT_CODE,
    GCT.TRANS_DATE,
    GCT.ID;
